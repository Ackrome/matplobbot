# Dockerfile.worker
ARG WORKER_BASE_IMAGE=ghcr.io/ackrome/matplobbot-base-worker:latest
FROM ${WORKER_BASE_IMAGE}

USER root
# Runtime isolation must also be present when reusing an older base image.
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap util-linux chromium && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV APP_BOT_DIR=/app/bot \
    APP_TEMPLATES_DIR=/app/bot/templates

# Copy shared lib and install
COPY shared_lib/ /shared_lib/
COPY setup.py /
RUN pip install --no-cache-dir --timeout 100 --retries 5 /

# Copy application resources
COPY bot/puppeteer-config.json /app/bot/
COPY bot/pandoc_mermaid_filter.py /app/bot/
COPY bot/pandoc_math_filter.lua /app/bot/
COPY bot/templates/ /app/bot/templates/

RUN chmod +x /app/bot/pandoc_mermaid_filter.py

# Create a non-root user for secure worker execution. Do not force UID 1000:
# the node-based base image already reserves that UID for its `node` user.
RUN if id -u appuser >/dev/null 2>&1; then \
      :; \
    else \
      useradd -m -s /bin/bash appuser; \
    fi && chown -R appuser:appuser /app

USER appuser

CMD ["celery", "-A", "shared_lib.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
