# Основной домен (Nginx сам разберется с путями)
ivantishchenko.ru {
    reverse_proxy 127.0.0.1:8080
}

# Поддомен API (для авторизации и статистики)
api.ivantishchenko.ru {
    reverse_proxy 127.0.0.1:9583
}

# Personal and private-network routes live in the untracked Caddyfile.local.
# Keep that file on the deployment host and never commit its internal IPs.
import /etc/caddy/Caddyfile.local
