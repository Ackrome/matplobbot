# =====================================================================
# Matplobbot Environment Variables Template
# Copy this file to .env and configure the values for your environment.
# =====================================================================

# --- Core Telegram Bot Configuration ---
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
ADMIN_USER_IDS=123456789,987654321
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_CREDENTIAL_KEY=generate_with_cryptography_fernet_and_keep_stable
MAIL_ALLOWED_HOSTS=

# --- Security & Web Auth ---
JWT_SECRET_KEY=change_this_to_a_secure_random_jwt_secret_in_production
STATS_USER=admin
STATS_PASS=change_this_admin_password_in_production

# --- Environment Mode ---
ENVIRONMENT=development
# DEBUG, INFO, WARNING, ERROR, or CRITICAL (WARN/FATAL aliases are accepted).
LOG_LEVEL=INFO
# text or json. Leave empty to use JSON in production and text otherwise.
LOG_FORMAT=

# --- PostgreSQL Database ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=matplobbot_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/matplobbot_db

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Persistence window for generated Telegram callback-data mappings.
CALLBACK_PATH_TTL_SECONDS=1209600

# Caddy private routes. Production hosts should point this to their untracked
# file, for example CADDY_LOCAL_FILE=./Caddyfile.local.
CADDY_LOCAL_FILE=./Caddyfile.local.example

# --- Public URL & CORS ---
PUBLIC_SITE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
