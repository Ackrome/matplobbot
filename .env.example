# =====================================================================
# Matplobbot Environment Variables Template
# Copy this file to .env and configure the values for your environment.
# =====================================================================

# --- Core Telegram Bot Configuration ---
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
ADMIN_USER_IDS=123456789,987654321
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_CREDENTIAL_KEY=generate_with_cryptography_fernet_and_keep_stable
MAIL_ALLOWED_HOSTS=

# --- Security & Web Auth ---
JWT_SECRET_KEY=change_this_to_a_secure_random_jwt_secret_in_production
STATS_USER=admin
STATS_PASS=change_this_admin_password_in_production

# --- Environment Mode ---
ENVIRONMENT=development

# --- PostgreSQL Database ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=matplobbot_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/matplobbot_db

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Public URL & CORS ---
PUBLIC_SITE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
